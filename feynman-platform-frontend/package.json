{
  "name": "feynman-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:build": "cross-env ELECTRON_BUILD=1 npm run build && electron-builder",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.2",
    "axios": "^1.20.0",
    "d3-force-3d": "^3.0.6",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "mermaid": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-media-recorder": "^1.7.2",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.feynman-platform.app",
    "productName": "FeynLab",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "directories": {
      "output": "release"
    }
  }
}
